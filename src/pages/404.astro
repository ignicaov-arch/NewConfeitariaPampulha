---
import '../styles/site.css';
import { BRAND } from '../data/brand';
import { buildSiteSchemaGraph } from '../domain/seoSchema';
import { buildWhatsAppUrl, sanitizeUrl } from '../domain/whatsapp';
import CookieConsent from '../components/CookieConsent';
import FooterSection from '../components/FooterSection';
import LogoEmblem from '../components/LogoEmblem';
import WhatsAppFloat from '../components/WhatsAppFloat';

const schemaJson = buildSiteSchemaGraph('home');
const helpWhatsappHref = sanitizeUrl(
  buildWhatsAppUrl(
    'Olá, equipe Confeitaria Pampulha! Acessei um link que não abriu e gostaria de ver o cardápio.'
  )
);
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Página Não Encontrada | Confeitaria Pampulha</title>
  <meta
    name="description"
    content="O endereço procurado não foi encontrado. Volte para a Confeitaria Pampulha, veja o cardápio artesanal ou fale conosco pelo WhatsApp."
  />
  <meta
    name="robots"
    content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  />
  <link rel="canonical" href="https://newconfeitariapampulha.pages.dev/" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content={BRAND.name} />
  <meta property="og:url" content="https://newconfeitariapampulha.pages.dev/" />
  <meta property="og:title" content="Página Não Encontrada | Confeitaria Pampulha" />
  <meta
    property="og:description"
    content="Palha italiana artesanal, brownies recheados, bolos de pote, tortas e brindes corporativos no Itapoã, BH."
  />
  <meta property="og:image" content="https://newconfeitariapampulha.pages.dev/img/og-pampulha-1200x630.webp" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2B1712" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Instrument+Serif:ital@0;1&display=swap"
    rel="stylesheet"
  />
  <script is:inline type="application/ld+json" set:html={schemaJson.replace(/</g, '\\u003c')} />
</head>
<body>
  <header class="topo is-rolou" id="topo">
    <div class="topo__pilula max-w-5xl">
      <a class="marca text-current" href="/" style="color: inherit; text-decoration: none;">
        <LogoEmblem size={34} />
        <span>Confeitaria Pampulha</span>
      </a>
      <nav class="menu" aria-label="Principal">
        <a href="/">Início</a>
        <a href="/#cardapio">Cardápio</a>
        <a href="/#orcamento">Simulador</a>
        <a href="/linkbio">LinkBio</a>
      </nav>
      <a class="botao botao--pequeno topo__cta" href="/#orcamento">Encomendar</a>
    </div>
  </header>

  <main class="wrap max-w-4xl" style="padding-top: 140px; padding-bottom: 64px; text-align: center;">
    <section
      style="padding: clamp(32px, 6vw, 60px); border-radius: 28px; background: var(--papel, #FFFDFB); border: 1px solid var(--linha, rgba(43, 23, 18, 0.12));"
    >
      <p class="etiqueta"><i aria-hidden="true" />Caminho não encontrado</p>
      <h1 class="titulo-m" style="margin-bottom: 18px;">
        Essa página mudou de lugar, mas <em>os doces continuam frescos.</em>
      </h1>
      <p style="max-width: 580px; margin: 0 auto 28px; color: var(--texto-suave, #684A42);">
        O link que você tentou abrir não está mais disponível. Você pode retornar à página inicial
        da Confeitaria Pampulha, abrir nossos atalhos rápidos ou chamar nossa equipe no WhatsApp.
      </p>

      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px;">
        <a class="botao" href="/">
          <span>Voltar para a página inicial</span>
        </a>
        <a class="botao botao--linha" href="/linkbio">
          <span>Abrir LinkBio (/linkbio)</span>
        </a>
        <a
          class="botao botao--escuro text-white"
          href={helpWhatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          style="color: #FFFDFB;"
        >
          <span>Chamar no WhatsApp</span>
          <span class="botao__seta" aria-hidden="true">
            <svg
              width={18}
              height={18}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth={2}
              strokeLinecap="round"
              strokeLinejoin="round"
              vectorEffect="non-scaling-stroke"
            >
              <path d="M5 12h14M13 6l6 6-6 6" vectorEffect="non-scaling-stroke" />
            </svg>
          </span>
        </a>
      </div>
    </section>
  </main>

  <footer class="rodape">
    <FooterSection isHome={false} />
  </footer>
  <CookieConsent />
  <WhatsAppFloat />

  <script>
    import '../scripts/smoothMotion';
    import '../scripts/interactions';
  </script>
</body>
</html>
